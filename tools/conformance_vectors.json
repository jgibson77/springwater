   "expect": {
    "tree": {
     "element": "Springwater",
     "children": [
      {
       "element": "paragraph",
       "children": [
        {
         "content": "The word",
         "ending": "lf"
        },
        {
         "element": "emphasis",
         "children": [
          {
           "content": "important",
           "ending": "lf"
          }
         ]
        },
        {
         "content": "appears in this sentence.",
         "ending": "lf"
        }
       ]
      }
     ]
    }
   }
  },
  {
