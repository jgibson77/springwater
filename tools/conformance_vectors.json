{
 "springwater": "1.0",
 "note": "Language-neutral conformance vectors for the Springwater v1.0 parsing algorithm, generated from tools/algorithm_verification.py. 'ending' is lf, crlf, cr, or none. An implementation conforms on a vector when it reports the same error kind or builds the same tree.",
 "parse_vectors": [
  {
   "name": "minimal",
   "input_base64": "XlNwcmluZ3dhdGVyCl5TcHJpbmd3YXRlci8K",
   "input_text": "^Springwater\n^Springwater/\n",
   "expect": {
    "tree": {
     "element": "Springwater",
     "children": []
    }
   }
  },
  {
   "name": "minimal without trailing newline",
   "input_base64": "XlNwcmluZ3dhdGVyCl5TcHJpbmd3YXRlci8=",
   "input_text": "^Springwater\n^Springwater/",
   "expect": {
    "tree": {
     "element": "Springwater",
     "children": []
    }
   }
  },
  {
   "name": "single container",
   "input_base64": "XlNwcmluZ3dhdGVyCl5kb2N1bWVudApIZWxsbywgd29ybGQhCl5kb2N1bWVudC8KXlNwcmluZ3dhdGVyLwo=",
   "input_text": "^Springwater\n^document\nHello, world!\n^document/\n^Springwater/\n",
   "expect": {
    "tree": {
     "element": "Springwater",
     "children": [
      {
       "element": "document",
       "children": [
        {
         "content": "Hello, world!",
         "ending": "lf"
        }
       ]
      }
     ]
    }
   }
  },
