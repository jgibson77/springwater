   "input_text": "^Springwater\n^code\n@State var count = 0\n@Observable class Model {}\n#include <stdio.h>\n$PATH\njohn@example.com\n^code/\n^Springwater/\n",
   "expect": {
    "tree": {
     "element": "Springwater",
     "children": [
      {
       "element": "code",
       "children": [
        {
         "content": "@State var count = 0",
         "ending": "lf"
        },
        {
         "content": "@Observable class Model {}",
         "ending": "lf"
        },
        {
         "content": "#include <stdio.h>",
         "ending": "lf"
        },
        {
         "content": "$PATH",
         "ending": "lf"
        },
        {
         "content": "john@example.com",
         "ending": "lf"
        }
       ]
      }
     ]
    }
   }
  },
  {
